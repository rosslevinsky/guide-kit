{
  // PLACEHOLDER. The real content is GENERATED by cfadapter.py, and this file's
  // body is never what a guide ends up with.
  //
  // It still exists for two reasons: `templates/web/` is copied wholesale into
  // `app/` when the web layer is materialized (bootstrap.py --with-web /
  // adopt-web.py), and kit-manifest.toml's exhaustiveness rule requires every
  // tracked file to be classified. Both bootstrap and adopt-web overwrite this
  // immediately with `cfadapter.render_wrangler_jsonc(<the target's config>)`.
  //
  // It is deliberately NOT a copy of the generated output. The deploy config is
  // derived from `guide.toml` — `workers_dev` from whether a domain is set, and
  // the `routes` block only when one is — which is conditional STRUCTURE that no
  // template can express. Keeping a full second copy here would give the family
  // two sources for one file, and the drift between them would be silent, which
  // is exactly the failure mode this kit keeps having to design against.
  //
  // To see or change what a guide actually gets, read cfadapter.py and run
  // `make wrangler`.
  "name": "PLACEHOLDER-overwritten-by-cfadapter",
  "compatibility_date": "2026-04-23",
  "assets": {
    "directory": "./dist"
  }
}
