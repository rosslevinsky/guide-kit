# Pixi managed env (pixi.lock IS committed for reproducibility)
.pixi/

# Working build directory — `make` writes the fresh render to
# build/<slug>.pdf and (with `make html`) build/<slug>.html. The committed
# reference PDF lives at the repo ROOT as <slug>.pdf (downloadable from
# GitHub); nothing under build/ is tracked.
build/

# Verify harness output (per-page diff PNGs written on `make verify` failure).
verify-diff/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS clutter
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~
.claude/
